{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bd export -o .beads/issues.jsonl >/dev/null 2>&1 || true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "(bd bootstrap; bd import .beads/issues.jsonl) >/dev/null 2>&1; bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
