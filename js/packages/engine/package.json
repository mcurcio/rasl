{
  "name": "@rasl/engine",
  "version": "0.1.0",
  "description": "Core engine for RASL: graph, scheduler, and runtime primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
