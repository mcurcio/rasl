{
  "name": "@rasl/web",
  "version": "0.1.0",
  "private": true,
  "description": "The rasl web UI: the graph, live metrics, and the graph editor that writes the config files",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf ../../../src/rasl/app/ui",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mcurcio/patchbay": "0.5.0",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.9.3",
    "graphql-ws": "5.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "^5.3.0",
    "vite": "5.4.11",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
