{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@rasl/engine": ["packages/engine/src/index.ts"],
      "@rasl/color": ["packages/color/src/index.ts"],
      "@rasl/nodes": ["packages/nodes/src/index.ts"],
      "@rasl/*": ["packages/*/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  }
}
